<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
         http://www.springframework.org/schema/beans/spring-beans.xsd http://www.springframework.org/schema/context https://www.springframework.org/schema/context/spring-context.xsd">
<!--    <bean id="helloWorld" class="com.example.HelloWorld">-->
<!--    </bean>-->

    <bean id="student" class="com.example.Student">
    </bean>

    <bean id="address2" class="com.example.Address2"/>
    <bean id="student2" class="com.example.Student2">
        <property name="address" ref="address2"/>
    </bean>

    <bean id="address4" class="com.example.Address4"/>
    <bean id="student4" class="com.example.Student4">
        <property name="address" ref="address4"/>
    </bean>

    <context:component-scan base-package="com.example"/>






</beans>
